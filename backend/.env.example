# FitBuddy AI Backend Environment Configuration Example
APP_NAME="FitBuddy AI"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Token Configuration
# Generate a secure secret using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="fitbuddy-ai-development-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite for local, PostgreSQL compatible)
# For SQLite: sqlite:///./fitbuddy.db
# For PostgreSQL: postgresql://user:password@localhost:5432/fitbuddy_db
DATABASE_URL="sqlite:///./fitbuddy.db"

# Google Gemini AI Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000"
